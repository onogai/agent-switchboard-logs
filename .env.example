# Comma-separated existing Docker Compose projects to collect logs from
LOGGING_COMPOSE_PROJECTS=agent-switchboard,another-service

# Docker network used by the public Gateway
LOGGING_GATEWAY_NETWORK=agent-switchboard_default

# Reuse the local-interactive Gateway's current private network when applicable
LOGGING_PRIVATE_NETWORK=switchboard-logging-private

# This installation owns its own fresh containers and named volumes
LOGGING_PROJECT_NAME=switchboard-logging
LOGGING_MCP_ALIAS=switchboard-logging-mcp
